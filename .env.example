# Пример окружения. Скопируй в .env и заполни — .env в репозиторий не попадает.
# Локально всё работает и БЕЗ единой переменной: значения по умолчанию рассчитаны
# на запуск на своей машине.

# --- OpenDota ---------------------------------------------------------------
# Необязателен: API работает и без ключа, просто с меньшими лимитами.
# Взять можно на https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# --- Сервер -----------------------------------------------------------------
# PORT задаёт хостинг (Render и подобные). Если он есть, сервер слушает 0.0.0.0,
# иначе остаётся на 127.0.0.1 — локальный инструмент не должен торчать в сеть.
# PORT=8000
# HOST=127.0.0.1

# Сколько секунд ждать, пока OpenDota распарсит матч. Локально не жалко три
# минуты; за обратным прокси столько ждать нельзя — ставь 60.
# PARSE_TIMEOUT_SEC=180

# Каталог кэша ответов API. На хостинге файловая система эфемерная: кэш живёт
# до перезапуска, и это нормально — он всего лишь оптимизация.
# DOTA2COACH_CACHE_DIR=.cache

# --- Фидбэк -----------------------------------------------------------------
# Файл с отзывами. ВНИМАНИЕ: на хостинге с эфемерной ФС он исчезнет при
# перезапуске. Отзывы всегда дублируются в stdout — их видно в логах Render.
# FEEDBACK_FILE=feedback.jsonl

# Если задать — каждый отзыв дополнительно уходит POST-запросом сюда
# (Google Apps Script, Formspree, свой эндпоинт). Единственный способ хранить
# отзывы по-настоящему, не поднимая базу.
# FEEDBACK_WEBHOOK_URL=
